{
    "name":  "2mart-erp",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "pnpm@9.1.0",
    "scripts":  {
                    "dev":  "turbo run dev",
                    "lint":  "turbo run lint",
                    "test":  "turbo run test",
                    "typecheck":  "turbo run typecheck",
                    "validate:architecture":  "turbo run validate:architecture",
                    "prepare":  "husky install",
                    "start":  "pnpm --filter api start",
                    "build":  "turbo run build --filter=admin --filter=pos \u0026\u0026 pnpm --filter api exec prisma generate"
                },
    "devDependencies":  {
                            "husky":  "^8.0.0",
                            "turbo":  "^2.0.0"
                        },
    "engines":  {
                    "node":  "\u003e=20",
                    "pnpm":  "\u003e=8"
                },
    "overrides":  {
                      "react":  "^19.2.7",
                      "react-dom":  "^19.2.7"
                  },
    "resolutions":  {
                        "react":  "^19.2.7",
                        "react-dom":  "^19.2.7"
                    },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "@prisma/client",
                                               "@prisma/engines",
                                               "prisma"
                                           ]
             }
}
